# .env.example
#
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — credentials are NEVER committed.
#
# These variables are only needed when USE_MINIO = TRUE in config.R.
# For local development, you can leave this file empty.

MINIO_ENDPOINT=http://minio.institution.local:9000
MINIO_BUCKET_RAW=anstat-raw
MINIO_BUCKET_SIL=anstat-silver
MINIO_ACCESS_KEY=your_access_key_here
MINIO_SECRET_KEY=your_secret_key_here
